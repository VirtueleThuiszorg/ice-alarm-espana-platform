# Supabase Configuration
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Sentry (Error Tracking)
VITE_SENTRY_DSN="your-sentry-dsn"

# App Version (used for Sentry release tracking)
VITE_APP_VERSION="1.0.0"

# Firebase Cloud Messaging (push notifications to staff phones)
#
# THESE ARE A FALLBACK NOW, NOT THE WAY TO CONFIGURE PUSH. Paste the Firebase web-app config
# snippet and the VAPID key into Admin → Settings → Notifications → Firebase instead: those are
# read at RUNTIME, take effect without a redeploy, and win over anything set here. These six
# remain so a deployment already configured this way keeps working untouched.
#
# ALL SIX OR NONE: a partial config throws inside the Firebase SDK with a message that names
# none of the missing keys. The first five are on Firebase → Project settings → General;
# VITE_FIREBASE_VAPID_KEY is on Cloud Messaging → Web Push certificates, which is why it is the
# one that gets forgotten. None of the six is a secret — they ship in the client bundle.
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_VAPID_KEY="your-vapid-key"
# The SERVER half, and the only Firebase value that IS a secret: the service-account JSON.
# OPTIONAL — the same JSON can be pasted into Admin → Settings → Notifications → Firebase, where
# it is stored as `settings_firebase_service_account_key` (the `_key` suffix is what excludes it
# from every non-super-admin read). This Edge secret is checked FIRST and is the stronger option:
# it never touches a table, so no RLS mistake can expose it.
#
# _shared/fcm.ts signs a JWT with it for FCM HTTP v1 — there is no legacy server key, that
# endpoint was retired in 2024. Paste the JSON whole; escaped \n inside private_key is
# un-escaped for you, because both dashboards turn a pasted newline into one and `importKey`
# then fails with "invalid keyData".
#   supabase secrets set FIREBASE_SERVICE_ACCOUNT="$(cat service-account.json)"
FIREBASE_SERVICE_ACCOUNT='{"project_id":"...","client_email":"...","private_key":"..."}'

# Sync Hub Integration
VITE_SYNCHUB_SUPABASE_URL=https://[sync-hub-project-ref].supabase.co
VITE_SYNCHUB_SUPABASE_ANON_KEY=[sync-hub-anon-key]
VITE_SYNCHUB_APP_ID=lifelink

# ============================================================================
# Edge Function secrets (server-side)
# ----------------------------------------------------------------------------
# These are read by Supabase Edge Functions via Deno.env.get() and MUST be set
# with `supabase secrets set KEY=value` on the backend (crpsuhoixfdhjugprbuc).
# They are NOT bundled into the frontend and never belong in a committed .env.
#
# NOTE: SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are
# auto-injected into every Edge Function by the Supabase runtime — do not set
# them manually.
#
# NOTE: Stripe and Mollie API/secret/webhook keys are NOT env vars — they are
# stored in the `system_settings` table and entered via Admin -> Settings
# (see LAUNCH_SCOPE.md §5). Do not add them here.
# ============================================================================

# General
SITE_URL="https://your-domain.example"
WEBHOOK_SECRET="your-internal-cron-webhook-secret"

# Email — Resend (transactional) + Gmail (fallback/inbound)
RESEND_API_KEY="your-resend-api-key"
SENDER_EMAIL="no-reply@your-domain.example"
SENDER_NAME="ICE Alarm España"
GMAIL_APP_PASSWORD="your-gmail-app-password"
# Supabase Auth "Send Email" hook secret (Auth → Hooks → Send Email; "v1,whsec_..." format)
SEND_EMAIL_HOOK_SECRET="v1,whsec_your-hook-secret"

# Twilio (voice / SMS / WhatsApp — SOS + notifications)
# May also be configured via system_settings; env vars take priority.
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_API_KEY_SID="your-twilio-api-key-sid"
TWILIO_API_KEY_SECRET="your-twilio-api-key-secret"
TWILIO_TWIML_APP_SID="your-twiml-app-sid"
TWILIO_PHONE_NUMBER="+10000000000"
TWILIO_OUTBOUND_NUMBER="+10000000000"
TWILIO_SOS_NUMBER="+10000000000"
TWILIO_WHATSAPP_NUMBER="whatsapp:+10000000000"

# EV-07B pendant ingestion (gps-gateway -> ev07b-* functions)
EV07B_HMAC_SECRET="your-ev07b-hmac-secret"
EV07B_ENFORCE_HMAC="true"
EV07B_CHECKIN_KEY="your-ev07b-checkin-key"

# Google OAuth (YouTube integration — phase 2 growth tooling)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Video render worker
RENDER_WORKER_URL="https://your-render-worker.example"

# Isabella AI — Anthropic API (ai-run core chat/voice/agent paths)
ANTHROPIC_API_KEY="your-anthropic-api-key"
# Optional model override for Isabella (defaults to claude-opus-4-8)
ISABELLA_MODEL="claude-opus-4-8"
# Lovable gateway key — NO LONGER used by Isabella core (ai-run migrated to
# Anthropic) or auth-email-hook (migrated to the standard send-email hook +
# Gmail SMTP). Still referenced only by the archive-candidate growth functions
# (outreach-*, media-draft, generate-ai-image, repurpose-content, ...).
LOVABLE_API_KEY="your-lovable-api-key"
